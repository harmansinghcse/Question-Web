{
    "expo": {
        "name": "Question Web",
        "slug": "question-Web-App",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "questionweb",
        "userInterfaceStyle": "automatic",

        "ios": {
            "icon": "./assets/images/QuestionWeb_logo.jpeg"
        },

        "android": {
            "package": "com.bitbybit.questionweb",
            "versionCode": 1,
            "adaptiveIcon": {
                "backgroundColor": "#070610",
                "foregroundImage": "./assets/images/android-icon-foreground.png",
                "backgroundImage": "./assets/images/android-icon-background.png",
                "monochromeImage": "./assets/images/android-icon-monochrome.png"
            },
            "predictiveBackGestureEnabled": false
        },

        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },

        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#070610",
                    "image": "./assets/images/icon.png",
                    "imageWidth": 180,
                    "resizeMode": "contain",
                    "dark": {
                        "backgroundColor": "#070610",
                        "image": "./assets/images/icon.png"
                    }
                }
            ],
            "expo-secure-store"
        ],

        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        },

        "runtimeVersion": {
            "policy": "appVersion"
        },

        "extra": {
            "eas": {
                "projectId": "12a76131-29c5-454b-ad94-5f8471e1bcee"
            }
        }
    }
}
