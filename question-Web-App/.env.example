# Copy this file to .env and set the correct URL for your environment.
#
# IMPORTANT: The URL must end with /api — NestJS uses that as its global prefix.
#
# Web running on the development computer (Expo web / iOS simulator):
#   EXPO_PUBLIC_API_URL=http://localhost:3000/api
#
# Android emulator (accesses host machine via the 10.0.2.2 alias):
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
#
# Physical Android or iOS device (replace with your machine's LAN IP):
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:3000/api
#
# The physical device must be on the same Wi-Fi network as the computer
# running the NestJS backend. Never commit a real IP to source control.

EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
